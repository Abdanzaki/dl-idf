# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Large datasets & raw data (as per PLAN.md)
data/raw/*.csv
data/processed/*.csv
data/processed/*.npy
data/processed/*.npz

# Model weights and artifacts policy:
# Trained model files (~138 KB to 14.5 MB) are tracked in git for seamless portability
# so examiners and evaluators can immediately run the API and Dashboard without retraining.
# Temporary checkpoints or HDF5 exports are ignored:
saved/*.h5
saved/*.joblib

# Operating System files
.DS_Store
Thumbs.db
